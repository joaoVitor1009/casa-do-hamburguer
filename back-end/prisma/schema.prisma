generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  cep       String
  password  String
  admin     Boolean    @default(false)
  cartitems CartItem[]
}

model Product {
  id          String     @id @default(uuid())
  name        String
  description String
  price       Int
  img         String
  createdAt   DateTime   @default(now())
  category    String
  cartitems   CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  userId    String
  productId String
  quantity  Int     @default(1)
  productid Product @relation(fields: [productId], references: [id])
  userid    User    @relation(fields: [userId], references: [id])
}
